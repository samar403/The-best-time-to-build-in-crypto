# Port for the API + console (default 8787)
PORT=8787

# Optional: lets the flight-plan composer use Claude instead of the built-in parser
ANTHROPIC_API_KEY=
# Model for the composer (default claude-opus-5-5)
CLEARANCE_MODEL=claude-opus-5-5

# Sandbox traffic generator: "off" to start quiet
CLEARANCE_SIMULATOR=on
# Pause between pipeline stages so the console can show movement (ms)
CLEARANCE_STAGE_DELAY_MS=650
